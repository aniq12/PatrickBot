# Copy this file to .env and fill it in. Never commit .env.

# Bot owner(s): full numbers with country code, comma-separated, no + or spaces.
# Owners can use owner-only commands and receive error reports when a plugin crashes.
OWNER_NUMBERS=628123456789
OWNER_NAME=Owner

# Only needed when starting with --mongo (otherwise data is kept in database.json).
# MongoDB Atlas: Database > Connect > Drivers, then replace <password>.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/PatrickBot?retryWrites=true&w=majority

# Optional: log in with a pairing code for this number instead of scanning a QR code.
# PAIRING_NUMBER=628123456789

# Optional: what .donasi shows, one item per "|".
# DONATION=Dana/Ovo : 08123456789 | https://saweria.co/yourname

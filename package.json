{
    "name": "PatrickBot",
    "version": "2.0.0",
    "description": "WhatsApp bot (Baileys) with games, stickers, downloaders, group tools and an XP/limit system",
    "main": "index.js",
    "type": "module",
    "directories": {
        "lib": "lib",
        "src": "src",
        "plugins": "plugins"
    },
    "scripts": {
        "start": "node index.js",
        "pm2": "pm2 start main.js --name patrickbot -- --mongo",
        "test": "node test.js"
    },
    "keywords": [
        "termux-whatsapp-bot",
        "whatsapp-bot",
        "whatsapp",
        "js-whatsapp",

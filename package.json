    "author": {
        "name": "BochilGaming"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aniq12/PatrickBot.git"
    },
    "bugs": {
        "url": "https://github.com/BochilGaming/games-wabot/issues"
    },
    "license": "GPL-3.0-or-later",
    "dependencies": {
        "@bochilteam/scraper": "^2.0.0",
        "awesome-phonenumber": "^2.68.0",
        "axios": "^0.24.0",
        "baileys": "^7.0.0-rc14",
        "cfonts": "^2.10.0",
        "chalk": "^5.0.0",
        "cheerio": "1.0.0-rc.12",
